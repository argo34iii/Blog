---
import {
  getPosts, postUrl, categoryUrl, archiveUrl, BOOKS_URL,
  monthKey, monthLabel, countBy,
} from '../lib/blog';
// 管理画面の「サイト設定 → プロフィール」で編集する
import profile from '../data/profile.json';

const posts = await getPosts();
const recent = posts.slice(0, 5);
const categories = countBy(posts.flatMap((p) => p.data.categories), (c) => c)
  .sort((a, b) => a[0].localeCompare(b[0], 'ja'));
const months = countBy(posts, (p) => monthKey(p.data.date))
  .sort((a, b) => b[0].localeCompare(a[0]));
---
<aside class="sidebar">
  <section>
    <h2>プロフィール</h2>
    <div class="profile">
      {profile.icon && <img class="icon" src={profile.icon} alt="" width="64" height="64" />}
      <p><strong>{profile.name}</strong>{profile.role && <><br />{profile.role}</>}</p>
    </div>
    {profile.bio && <p class="bio">{profile.bio}</p>}
  </section>

  <section>
    <ul class="links">
      <li><a href="/">ホームページ</a></li>
      {posts.some((p) => p.data.book) && <li><a href={BOOKS_URL}>📚 本棚</a></li>}
    </ul>
  </section>

  <section>
    <h2>最近の記事</h2>
    <ul>{recent.map((p) => <li><a href={postUrl(p)}>{p.data.title}</a></li>)}</ul>
  </section>

  <section>
    <h2>カテゴリー</h2>
    <ul>{categories.map(([c, n]) => <li><a href={categoryUrl(c)}>{c}</a> ({n})</li>)}</ul>
  </section>

  <section>
    <h2>アーカイブ</h2>
    <ul>{months.map(([k, n]) => <li><a href={archiveUrl(k)}>{monthLabel(k)}</a> ({n})</li>)}</ul>
  </section>
</aside>

<style>
  .sidebar { font-size: 0.9rem; }
  h2 {
    font-size: 0.95rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 4px;
    margin: 0 0 8px;
  }
  section { margin-bottom: 28px; }
  ul { margin: 0; padding-left: 1.2em; }
  p { margin: 0 0 8px; }
  .profile { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
  .profile p { margin: 0; }
  .icon { width: 64px; height: 64px; border-radius: 50%; object-fit: cover; flex: none; background: var(--line); }
  .bio { white-space: pre-wrap; }
  .links { list-style: none; padding: 0; }
</style>
