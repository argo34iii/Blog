---
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
    <style is:global>
      body {
        max-width: 640px;
        margin: 0 auto;
        padding: 24px 16px;
        font-family: sans-serif;
        line-height: 1.8;
      }
      img { max-width: 100%; }
      a { color: #0000ee; }
      a:visited { color: #551a8b; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
