---
const { title, wide = false } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
    <slot name="head" />
    <style is:global>
      :root {
        --text: #222;
        --muted: #777;
        --line: #ddd;
        --bg: #fff;
        --link: #0000ee;
        --visited: #551a8b;
      }
      body {
        max-width: 640px;
        margin: 0 auto;
        padding: 24px 16px;
        font-family: sans-serif;
        line-height: 1.8;
        color: var(--text);
        background: var(--bg);
      }
      body.wide { max-width: 960px; }
      img { max-width: 100%; height: auto; }
      a { color: var(--link); }
      a:visited { color: var(--visited); }
    </style>
  </head>
  <body class:list={{ wide }}>
    <slot />
  </body>
</html>
