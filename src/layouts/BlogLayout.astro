---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { BLOG_NAME } from '../lib/blog';
// 管理画面の「サイト設定 → ブログ」で編集する
import blog from '../data/blog.json';
import profile from '../data/profile.json';

const { title } = Astro.props;
const pageTitle = title ? `${title} - ${BLOG_NAME}` : BLOG_NAME;
---
<Base title={pageTitle} wide>
  <link slot="head" rel="alternate" type="application/rss+xml" title={BLOG_NAME} href="/blog/rss.xml" />
  {blog.headerImage ? (
    <header class="blog-header has-image">
      <a class="banner" href="/blog/" aria-label={BLOG_NAME}>
        <img src={blog.headerImage} alt="" />
        {blog.showTitleOnHeader && <span class="blog-title">{BLOG_NAME}</span>}
      </a>
    </header>
  ) : (
    <header class="blog-header">
      <a class="blog-title" href="/blog/">{BLOG_NAME}</a>
    </header>
  )}

  <div class="blog-body">
    <main id="content">
      <slot />
    </main>
    <Sidebar />
  </div>

  <footer class="blog-footer">
    <p>©{new Date().getFullYear()} {profile.name}</p>
    <p><a href="#">トップへ戻る</a></p>
  </footer>
</Base>

<style is:global>
  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 12px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .blog-title {
    font-size: 1.4rem;
    font-weight: bold;
    color: var(--text);
    text-decoration: none;
  }
  .blog-header.has-image { padding: 0; border: none; display: block; }
  .banner {
    position: relative;
    display: block;
    aspect-ratio: 4 / 1;
    min-height: 110px;
    overflow: hidden;
    border-radius: 6px;
    background: var(--line);
  }
  .banner img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .banner .blog-title {
    position: absolute;
    left: 16px;
    bottom: 12px;
    color: #fff;
    font-size: 1.8rem;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
  }
  .blog-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 40px;
  }
  @media (max-width: 760px) {
    .blog-body { grid-template-columns: minmax(0, 1fr); }
  }
  .blog-footer {
    margin-top: 48px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.85rem;
    display: flex;
    justify-content: space-between;
  }
  .meta {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .meta a { color: inherit; }
</style>
