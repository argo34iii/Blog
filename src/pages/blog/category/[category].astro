---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import PostList from '../../../components/PostList.astro';
import { getPosts } from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  const cats = [...new Set(posts.map((p) => p.data.category))];
  return cats.map((category) => ({
    params: { category },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  }));
}

const { category, posts } = Astro.props;
---
<BlogLayout title={`カテゴリー: ${category}`}>
  <h1 class="list-title">カテゴリー: {category}</h1>
  <PostList posts={posts} />
</BlogLayout>

<style>
  .list-title { font-size: 1.1rem; margin-top: 0; }
</style>
